# Chat model (generation, agent loop) and batch jobs (classify_letters, checkRegests, classifyPlaces).
# Default: DeepSeek V4.1 Flash (deepseek-flash), thinking disabled. See server/llm.js.
DEEPSEEK_API_KEY=
# Every provider with a key joins the batch pool (each account is rate limited on its own):
ZHIPU_API_KEY=
NETWAYS_API_KEY=
# Optional: LLM_PROVIDER=zhipu|netways|netways-gptoss for chat; LLM_BATCH_PROVIDER pins batch jobs to one provider;
# LLM_THINKING=low|high|max enables thinking for chat.
# Query embeddings: EMBED_PROVIDER=netways uses Netways' hosted BAAI/bge-m3 (same model as the
# index, no local Ollama needed). Default: local Ollama bge-m3.
# EMBED_PROVIDER=netways
# Netways batch jobs run at most NETWAYS_CONCURRENCY requests at once (default 8; more runs into the 429 window limit).
