# Chat model (generation, agent loop) and batch jobs (classify_letters, checkRegests, classifyPlaces).
# Default: DeepSeek V4.1 Flash (deepseek-flash), thinking disabled. See server/llm.js.
DEEPSEEK_API_KEY=
# Optional alternative: LLM_PROVIDER=zhipu (glm-5.3-flash, ZHIPU_API_KEY); LLM_THINKING=low|high|max enables DeepSeek thinking for chat.
ZHIPU_API_KEY=
